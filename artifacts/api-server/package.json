{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ai": "node ./test/run-ai.mjs",
    "test:daily": "node ./test/run-ai.mjs daily",
    "test:dashboard": "node ./test/run-ai.mjs dashboard",
    "test:dashboard:postgres": "node --test --test-name-pattern='Feature 10 dashboard' ./test/reward-atomicity.mjs",
    "test:newdashboard": "node ./test/run-ai.mjs dashboard && node --test ./test/reward-atomicity.mjs",
    "test:journey": "node ./test/run-ai.mjs journey",
    "test:social-circles": "node --test ./test/social-challenge-habit.mjs ./test/social-circles-http.mjs",
    "test:recovery": "node ./test/recovery-flow.mjs",
    "test:rewards": "node ./test/reward-atomicity.mjs",
    "test:decorations": "node ./test/decoration-atomicity.mjs",
    "test:ai:live": "node ./test/run-ai.mjs smoke"
  },
  "dependencies": {
    "@clerk/express": "^2.1.72",
    "@clerk/shared": "^4.36.0",
    "@google-cloud/storage": "^8.2.0",
    "@google/genai": "^2.24.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
